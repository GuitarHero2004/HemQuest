<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Emerald & Saigon Jade Gradient Base -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#006A4E" />
                <item android:offset="0.55" android:color="#0B4635" />
                <item android:offset="1.0" android:color="#04261D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Warm Golden Sunrise Ambient Glow from Top -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:alpha="0.4">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="25"
                android:gradientRadius="65"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFD166" />
                <item android:offset="0.6" android:color="#E76F51" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Traditional Vietnam Diamond Lattice Motif -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.09"
        android:strokeWidth="1.2"
        android:pathData="M54,14 L94,54 L54,94 L14,54 Z" />
    <path
        android:strokeColor="#FFD166"
        android:strokeAlpha="0.14"
        android:strokeWidth="1"
        android:pathData="M54,22 L86,54 L54,86 L22,54 Z" />
</vector>

